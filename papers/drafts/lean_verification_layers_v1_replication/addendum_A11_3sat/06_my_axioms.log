'SatLowerBound.paper_finite_ceiling_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
'SatLowerBound.paper_logarithmic_bound_graph_equations' depends on axioms: [propext, Classical.choice, Quot.sound]
'SatLowerBound.paper_finite_ceiling_bound_graph_equations' depends on axioms: [propext, Classical.choice, Quot.sound]
'SatLowerBound.main_lower_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
SatLowerBound.paper_finite_ceiling_bound : ∀ (w r k : ℕ),
  2 ≤ w →
    r < w →
      4 ≤ r →
        3 ≤ k →
          k + 2 ≤ r →
            2 ^ (k - 2) > Real.logb 2 (6 * ↑r * (↑r - 1)) + ↑r * Real.logb 2 3 →
              ∀ (C : SatLowerBound.Circuit (SatLowerBound.inputBits w)),
                C.Computes (SatLowerBound.satFunction w) →
                  ↑(SatLowerBound.inputBits w) +
                      ⌈((30 * ↑r - 42 * (↑k + 1)) * (↑(SatLowerBound.variableCount w) - 2 ^ r) - 3) / 7⌉ ≤
                    ↑C.size
SatLowerBound.paper_logarithmic_bound_graph_equations : ∀ (w : ℕ),
  32 ≤ w →
    ∀ (s : ℕ) (N : SatLowerBound.AcyclicNetwork (SatLowerBound.inputBits w) s),
      (∀ (v : Fin (SatLowerBound.inputBits w) → Bool),
          ∃ gates,
            N.GateConsistent v gates ∧
              SatLowerBound.AcyclicNetwork.wireValue v gates N.output = SatLowerBound.satFunction w v) →
        17 / 7 * ↑(SatLowerBound.inputBits w) -
            70 * ↑(SatLowerBound.inputBits w) * Real.logb 2 (Real.logb 2 ↑(SatLowerBound.inputBits w)) /
              Real.logb 2 ↑(SatLowerBound.inputBits w) ≤
          ↑s
